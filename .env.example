# Copy to .env. Never commit .env or real credentials.
APPLYGO_ENV=development
APPLYGO_DATABASE_URL=sqlite:///./data/applygo.db
APPLYGO_STORAGE_DIR=./data/private
APPLYGO_SECRET_KEY=replace-with-a-long-random-value
APPLYGO_MODEL_PROVIDER=mock
APPLYGO_MODEL_NAME=mock-fit-v1

# Optional hosted providers. Use API keys, not consumer chat subscriptions.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local Ollama-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Optional future remote browser adapter.
STEEL_API_KEY=

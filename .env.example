# Copy to .env. Never commit .env or real credentials.
APPLYGO_ENV=development
APPLYGO_DATABASE_URL=sqlite:///./data/applygo.db
APPLYGO_STORAGE_DIR=./data/private
APPLYGO_SECRET_KEY=replace-with-a-long-random-value

# Default route used when a task-specific route is not configured.
APPLYGO_MODEL_PROVIDER=mock
APPLYGO_MODEL_NAME=mock-fit-v1

# Optional task-specific routing. Keep on one line in .env.
# Providers: mock, openai, anthropic, ollama, openai_compatible, claude_code, claude_routine
# Execution modes: synchronous, local, queued
APPLYGO_MODEL_ROUTES_JSON={"fit_assessment":{"provider":"mock","model":"mock-fit-v1","execution_mode":"synchronous"}}

# Separately billed hosted APIs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Generic OpenAI-compatible local or hosted endpoint, such as LM Studio or vLLM.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_API_KEY=local

# Claude Code Routine. The Routine uses the owner's Claude subscription quota.
# Store these only on the machine or deployment that triggers the Routine.
CLAUDE_ROUTINE_URL=
CLAUDE_ROUTINE_TOKEN=

# Claude Code local mode requires the `claude` executable and an authenticated local session.

# Optional future remote browser adapter.
STEEL_API_KEY=

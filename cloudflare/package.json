{
  "name": "applygo-cloudflare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "check:production": "wrangler deploy --dry-run --outdir dist --env production",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --env=\"\"",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:production": "wrangler deploy --env production",
    "migrate:local": "wrangler d1 migrations apply applygo --local --env=\"\"",
    "migrate:remote": "wrangler d1 migrations apply applygo --remote --env=\"\"",
    "migrate:remote:production": "wrangler d1 migrations apply applygo-prod-db --remote --env production",
    "release:production": "npm run migrate:remote:production && npm run deploy:production",
    "enroll": "node scripts/create-enrollment.mjs"
  },
  "dependencies": {
    "unpdf": "latest",
    "@cloudflare/puppeteer": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "applygo-personal",
  "main": "src/agent-gateway.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "applygo",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "applygo-private"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SESSION_DAYS": "90",
    "LOCAL_RENDER_URL": "http://127.0.0.1:8788"
  },
  // Jason's production deployment. Deployed and managed via `--env production`
  // (or Cloudflare Workers Builds, which is configured to use this env) so that
  // local development config above stays untouched.
  "env": {
    "production": {
      "name": "applygo-prod",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "applygo-prod-db",
          "database_id": "cfd20f38-862d-42b6-bf7a-9bfb7c0a6bdc",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "applygo-prod-private"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "observability": {
        "enabled": true
      },
      "vars": {
        "SESSION_DAYS": "90",
        // Non-secret model identifiers. ANTHROPIC_API_KEY / OPENAI_API_KEY are
        // set separately as Worker secrets (`wrangler secret put ... --env production`),
        // never here. Bump these if a model id is retired.
        "ANTHROPIC_MODEL": "claude-sonnet-5",
        "OPENAI_MODEL": "gpt-4o",
        // Cheap, high-volume tier. Used for the bulk yes/no job screen, where most postings are
        // obvious misses and paying reasoning-model rates to find that out is the expensive path.
        "ANTHROPIC_SCREEN_MODEL": "claude-haiku-4-5-20251001",
        "OPENAI_SCREEN_MODEL": "gpt-4o-mini"
      }
    }
  }
}

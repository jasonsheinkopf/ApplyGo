{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "applygo-personal",
  "main": "src/agent-gateway.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "applygo",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "applygo-private"
    }
  ],
  // Used by @cloudflare/workers-oauth-provider (the /mcp OAuth layer -- see agent-gateway.ts
  // and docs/architecture/mcp-connector.md) to store OAuth clients, grants, and tokens.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "fa3ecab8dd8e495993136401f8954a4b"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SESSION_DAYS": "90",
    "LOCAL_RENDER_URL": "http://127.0.0.1:8788"
  },
  // Jason's production deployment. Deployed and managed via `--env production`
  // (or Cloudflare Workers Builds, which is configured to use this env) so that
  // local development config above stays untouched.
  "env": {
    "production": {
      "name": "applygo-prod",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "applygo-prod-db",
          "database_id": "cfd20f38-862d-42b6-bf7a-9bfb7c0a6bdc",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "applygo-prod-private"
        }
      ],
      // A separate namespace from local dev's above, same as the D1/R2 bindings above it.
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "2073d56d77914f6e981735e24c6c35ff"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "observability": {
        "enabled": true
      },
      // The unattended pass (see runScheduledPass in src/agent-gateway.ts): scan boards for new
      // postings, then judge what came in. Daily at 13:23 UTC, roughly 6:23am Pacific, so a fresh
      // shortlist is waiting in the morning. Deliberately off the hour and off :00/:30 -- every
      // schedule that asks for "6am" lands on the same instant otherwise.
      "triggers": {
        "crons": ["23 13 * * *"]
      },
      "vars": {
        "SESSION_DAYS": "90",
        // How much one scheduled pass is allowed to spend. Tunable without a code change:
        // 8 boards and 12 model calls is roughly a dollar a day at current rates.
        "CRON_SCAN_COMPANIES": "8",
        "CRON_EVALUATE_CALLS": "12",
        // Non-secret model identifiers. ANTHROPIC_API_KEY / OPENAI_API_KEY are
        // set separately as Worker secrets (`wrangler secret put ... --env production`),
        // never here. Bump these if a model id is retired.
        "ANTHROPIC_MODEL": "claude-sonnet-5",
        "OPENAI_MODEL": "gpt-5.6-terra",
        // Cheap, high-volume tier. Used for the bulk yes/no job screen, where most postings are
        // obvious misses and paying reasoning-model rates to find that out is the expensive path.
        "ANTHROPIC_SCREEN_MODEL": "claude-haiku-4-5-20251001",
        "OPENAI_SCREEN_MODEL": "gpt-4o-mini",
        // Screening runs on OpenAI even when the rest of the job runs on Anthropic. Measured over
        // real batches, a screen call is $0.0161 on Haiku against $0.0021 on gpt-4o-mini -- about
        // eight times cheaper for a yes/no decision made on a job title alone. Deep assessment,
        // where model quality genuinely changes the verdict, still runs on the reasoning model.
        // Remove this line to put both tiers back on one provider.
        "SCREEN_PROVIDER": "openai"
      }
    }
  }
}
